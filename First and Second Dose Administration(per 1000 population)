# Fill zero/NaN values to avoid division issues if calculating ratios,
# and extract Dose 1 (TotalVaccinated) and Dose 2 (FullyVaccinated)
target_gdf['Dose1'] = pd.to_numeric(target_gdf['TotalVaccinated'], errors='coerce').fillna(0)
target_gdf['Dose2'] = pd.to_numeric(target_gdf['FullyVaccinated'], errors='coerce').fillna(0)

# Since actual population isn't explicitly defined in the columns, we can plot the
# total doses (in thousands) or use the existing metrics directly.
target_gdf['dose1_thousands'] = target_gdf['Dose1'] / 1000.0
target_gdf['dose2_thousands'] = target_gdf['Dose2'] / 1000.0

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 7), dpi=300)

# Plot First Dose (in Thousands)
target_gdf.plot(column='dose1_thousands', cmap='YlGnBu', scheme='FisherJenks', k=5,
         legend=True, ax=ax1, edgecolor='gray', linewidth=0.2,
         legend_kwds={'title': 'Dose 1 (Thousands)', 'loc': 'lower right', 'fmt': '{:.0f}'})
ax1.set_title("(a) First Dose Administration (Thousands)", fontsize=11, fontweight='bold')
ax1.axis('off')

# Plot Second Dose (in Thousands)
target_gdf.plot(column='dose2_thousands', cmap='YlOrRd', scheme='FisherJenks', k=5,
         legend=True, ax=ax2, edgecolor='gray', linewidth=0.2,
         legend_kwds={'title': 'Dose 2 (Thousands)', 'loc': 'lower right', 'fmt': '{:.0f}'})
ax2.set_title("(b) Second Dose Administration (Thousands)", fontsize=11, fontweight='bold')
ax2.axis('off')

