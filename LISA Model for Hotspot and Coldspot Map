axes[1].set_xlim(xlims)
axes[1].set_ylim(ylims)
axes[1].set_facecolor("#ffffff")

# Cartographic markers
draw_north_arrow(axes[1], x=0.08, y=0.18)
draw_scale_bar(axes[1], x_min=68.5, y_pos=7.5, segment_km=250)

# Panel (b) Legend
lisa_labels = {
    0: "Not Significant",
    1: "Hotspot (High-High)",
    2: "Coldspot (Low-Low)",
    3: "Low-High Outlier",
    4: "High-Low Outlier",
}
handles_b = [
    mpatches.Patch(facecolor=lisa_colors[k], edgecolor="#666666", lw=0.5, label=lisa_labels[k])
    for k in sorted(lisa_colors.keys())
