axes[0].text(85.5, 18.0, "BAY OF BENGAL", fontsize=10, fontstyle="italic", color="#555555")

# Cartographic markers
draw_north_arrow(axes[0], x=0.08, y=0.18)
draw_scale_bar(axes[0], x_min=68.5, y_pos=7.5, segment_km=250)

# Panel (a) Legend
handles_a = [
