leg_a.get_title().set_fontweight("bold")

# ------------------- PANEL (b) -------------------
lisa_colors = {
    0: "#f0f0f0",  # Not Significant
    1: "#d7191c",  # Hotspot (High-High)
    2: "#2b83ba",  # Coldspot (Low-Low)
    3: "#abd9e9",  # Low-High Outlier
    4: "#fdae61",  # High-Low Outlier
}
gdf["lisa_color"] = gdf["lisa_cluster"].map(lisa_colors)

gdf.plot(
    color=gdf["lisa_color"],
    linewidth=0.35,
    edgecolor="#555555",
    ax=axes[1],
)

axes[1].set_title(
    "(b) LISA Hotspot & Coldspot Analysis",
    fontsize=12,
    fontweight="bold",
    pad=10,
