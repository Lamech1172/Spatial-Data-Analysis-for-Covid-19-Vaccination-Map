def load_district_geometries(geojson_path):
    print("Loading GeoJSON geometries...")
    try:
        gdf = gpd.read_file(geojson_path)
    except Exception as e:
        print(f"Warning: Failed to load '{geojson_path}': {e}")
        print("Re-downloading official boundary fallback...")
        os.system("wget -qq https://raw.githubusercontent.com/datameet/Indian_Admin_Boundary_Maps/master/Districts/india_district.geojson -O /content/in_district.json")
        gdf = gpd.read_file("/content/in_district.json")

    if gdf.empty:
        raise ValueError("GeoJSON loaded into an empty GeoDataFrame.")

    if gdf.crs is None:
        gdf = gdf.set_crs(epsg=4326)
    else:
        gdf = gdf.to_crs(epsg=4326)

    print(f"Loaded {len(gdf)} district boundaries.")
    return gdf

