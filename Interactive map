def _clean_token(text):
    if text is None or pd.isna(text):
        return "", ""
    clean = str(text).lower().replace("&", "and").replace("*", "").replace(".", "")
    clean = re.sub(r"[^a-z0-9\s]", " ", clean)
    tokens = sorted(clean.split())
    compact = re.sub(r"\s+", "", clean)
    sorted_phrase = "".join(tokens)
    return compact, sorted_phrase

def match_districts(df, gdf):
    print("Matching districts...")
    df = df.copy()
    gdf = gdf.copy()

    st_candidates = [c for c in gdf.columns if c.lower() in ["stname", "state_name", "statename", "state"]]
    dt_candidates = [c for c in gdf.columns if c.lower() in ["dtname", "district_name", "districtname", "district"]]

    state_col = st_candidates[0] if st_candidates else "stname"
    dist_col = dt_candidates[0] if dt_candidates else "dtname"

    gdf["state_norm"] = gdf[state_col].apply(lambda x: STATE_ALIAS.get(_clean_token(x)[0], _clean_token(x)[0]))
    gdf[["dist_norm", "dist_sorted"]] = gdf[dist_col].apply(lambda x: pd.Series(_clean_token(x)))

    df["state_norm"] = df["State"].apply(lambda x: STATE_ALIAS.get(_clean_token(x)[0], _clean_token(x)[0]))
    df[["dist_norm", "dist_sorted"]] = df["District"].apply(lambda x: pd.Series(_clean_token(x)))

    state_to_geo = defaultdict(list)
    for idx, row in gdf.iterrows():
        state_to_geo[row["state_norm"]].append((row["dist_norm"], row["dist_sorted"], idx))

    matched_idx, match_types = [], []

    for _, row in df.iterrows():
        sn, dn, d_sort = row["state_norm"], row["dist_norm"], row["dist_sorted"]

        # Universal handler for Dadra / Nagar Haveli / Daman / Diu across all states
        if "dadra" in dn or ("nagar" in dn and "haveli" in dn):
            dnh_geo = gdf[gdf["dist_norm"].str.contains("dadra|haveli", regex=True, na=False)]
            if not dnh_geo.empty:
                matched_idx.append(dnh_geo.index[0])
                match_types.append("DNH_DIRECT")
                continue

        candidates = state_to_geo.get(sn, [])

        override = DISTRICT_ALIAS.get((sn, dn))
        if override:
            h = [idx for (n, _, idx) in candidates if n == override or n.startswith(override[:12])]
            if h:
                matched_idx.append(h[0])
                match_types.append("ALIAS")
                continue

        h = [idx for (n, _, idx) in candidates if n == dn]
        if h:
            matched_idx.append(h[0])
            match_types.append("EXACT")
            continue

        h = [idx for (n, _, idx) in candidates if len(n) >= 4 and (dn.startswith(n) or n.startswith(dn))]
        if h:
            matched_idx.append(h[0])
            match_types.append("PREFIX")
            continue

        if candidates:
            cand_names = [n for (n, _, _) in candidates]
            best = difflib.get_close_matches(dn, cand_names, n=1, cutoff=0.55)
            if best:
                matched_idx.append([idx for (n, _, idx) in candidates if n == best[0]][0])
                match_types.append("FUZZY_STATE")
                continue

        # Global fallback if state matching failed
        if "daman" in dn:
            daman_geo = gdf[gdf["dist_norm"].str.contains("daman", na=False)]
            if not daman_geo.empty:
                matched_idx.append(daman_geo.index[0])
                match_types.append("DAMAN_DIRECT")
                continue

        if "diu" in dn:
            diu_geo = gdf[gdf["dist_norm"].str.contains("diu", na=False)]
            if not diu_geo.empty:
                matched_idx.append(diu_geo.index[0])
                match_types.append("DIU_DIRECT")
                continue

        matched_idx.append(None)
        match_types.append("UNMATCHED")

    df["geo_idx"] = matched_idx
    df["match_type"] = match_types
    matched_count = df["geo_idx"].notna().sum()
    print(f"Matched {matched_count}/{len(df)} districts ({matched_count / len(df) * 100:.1f}%).")
    return df, gdf, state_col, dist_col

