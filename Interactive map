# STEP 4: MERGE DATA WITH GEOMETRY
# ======================================================================

def build_merged_geodataframe(df_matched, gdf, state_column, district_column):
    gdf[district_column] = gdf[district_column].astype(str).str.replace("*", "", regex=False).str.strip()

    matched_df = df_matched[df_matched["geo_idx"].notna()].copy()
    matched_df["geo_idx"] = matched_df["geo_idx"].astype(int)

    agg = matched_df.groupby("geo_idx").agg(
        TotalVaccinated=("TotalVaccinated", "sum"),
        FullyVaccinated=("FullyVaccinated", "sum"),
        Male=("Male", "sum"),
        Female=("Female", "sum"),
        Transgender=("Transgender", "sum"),
        Covaxin=("Covaxin", "sum"),
        CoviShield=("CoviShield", "sum"),
        State=("State", "first"),
        District=("District", "first")
    ).reset_index()

    geometry_df = gdf.copy()
    geometry_df["geo_idx"] = geometry_df.index
    merged = geometry_df.merge(agg, on="geo_idx", how="left")

    numeric_cols = ["TotalVaccinated", "FullyVaccinated", "Male", "Female", "Transgender", "Covaxin", "CoviShield"]
    for col in numeric_cols:
        merged[col] = pd.to_numeric(merged[col], errors="coerce").fillna(0)

    merged["GenderRatio"] = np.where(
        merged["Male"] > 0,
        (merged["Female"] / merged["Male"]) * 1000,
        np.nan
    ).round(1)

    return merged

# ======================================================================
# STEP 5: DIRECTLY RENDER INTERACTIVE MAP
# ======================================================================

def generate_interactive_map(merged, state_column, district_column):
    print("Building interactive map...")

    map_gdf = merged.copy()
    map_gdf["geometry"] = map_gdf["geometry"].simplify(tolerance=0.005, preserve_topology=True)
    map_gdf["geo_idx"] = map_gdf["geo_idx"].astype(str)

    map_gdf["disp_total"] = map_gdf["TotalVaccinated"].apply(lambda x: f"{int(x):,} doses")
    map_gdf["disp_fully"] = map_gdf["FullyVaccinated"].apply(lambda x: f"{int(x):,} doses")
    map_gdf["disp_ratio"] = map_gdf["GenderRatio"].apply(lambda x: f"{x:.1f}" if pd.notna(x) else "N/A")
    map_gdf["disp_covishield"] = map_gdf["CoviShield"].apply(lambda x: f"{int(x):,} doses")
    map_gdf["disp_covaxin"] = map_gdf["Covaxin"].apply(lambda x: f"{int(x):,} doses")

    m = folium.Map(
        location=[22.5, 80.0],
        zoom_start=5,
        tiles="CartoDB positron",
        control_scale=True
    )

    max_doses = max(map_gdf["TotalVaccinated"].quantile(0.98), 1000)
    cmap_total = cm.linear.YlGnBu_09.scale(0, max_doses)
    cmap_total.caption = "Total Vaccinated Cases (First Dose)"

    tooltip = folium.GeoJsonTooltip(
        fields=[
            district_column,
            state_column,
            "disp_total",
            "disp_fully",
            "disp_ratio",
            "disp_covishield",
            "disp_covaxin"
        ],
        aliases=[
            "District:",
            "State:",
            "Total Vaccination Cases (At least 1 Dose):",
            "Fully Vaccinated Cases (2 Doses):",
            "Gender Ratio (Females per 1k Males):",
            "Covishield Administered:",
            "Covaxin Administered:"
        ],
        localize=True,
        sticky=True
    )

    layer_total = folium.FeatureGroup(name="Total Vaccination Cases (>= 1 Dose)", overlay=False)
    folium.GeoJson(
        map_gdf,
        style_function=lambda f: {
            "fillColor": cmap_total(f["properties"]["TotalVaccinated"]) if f["properties"]["TotalVaccinated"] > 0 else "#e0e0e0",
            "color": "#4a4a4a",
            "weight": 0.4,
            "fillOpacity": 0.75,
        },
        highlight_function=lambda f: {"weight": 2.0, "color": "#000000", "fillOpacity": 0.95},
        tooltip=tooltip
    ).add_to(layer_total)
    layer_total.add_to(m)

    cmap_total.add_to(m)
    folium.LayerControl(collapsed=False).add_to(m)

    return m

# ======================================================================
# MAIN
# ======================================================================

def main():
    print("=" * 70)
    print("INDIA DISTRICT COVID-19 VACCINATION SPATIAL ANALYSIS")
    print("=" * 70)

    district_df = extract_latest_district_data(CSV_PATH)
    gdf = load_district_geometries(HGEOJSON_PATH)
    df_matched, gdf, state_col, dist_col = match_districts(district_df, gdf)

    merged = build_merged_geodataframe(df_matched, gdf, state_col, dist_col)

    save_cols = [c for c in df_matched.columns if c not in ["state_norm", "dist_norm", "dist_sorted"]]
    df_matched[save_cols].to_csv(OUT_TABLE, index=False)
    print(f"Cleaned table saved -> {OUT_TABLE}")

    map_obj = generate_interactive_map(merged, state_col, dist_col)
    display(map_obj)

if __name__ == "__main__":
    main()
